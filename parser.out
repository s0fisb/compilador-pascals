    (28) write_stmt -> . WRITELN LPAREN expr_list RPAREN
    (14) block -> . BEGIN block_enter stmt_list END

    ELSE            reduce using rule 22 (stmt -> .)
    END             reduce using rule 22 (stmt -> .)
    SEMICOLON       reduce using rule 22 (stmt -> .)
    error           shift and go to state 32
    ID              shift and go to state 33
    IF              shift and go to state 34
    WHILE           shift and go to state 35
    WRITELN         shift and go to state 36
    BEGIN           shift and go to state 11

    stmt                           shift and go to state 91
    assign_stmt                    shift and go to state 27
    if_stmt                        shift and go to state 28
    while_stmt                     shift and go to state 29
    write_stmt                     shift and go to state 30
    block                          shift and go to state 31

state 90

    (30) expr_list -> expr_list COMMA expr .

    RPAREN          reduce using rule 30 (expr_list -> expr_list COMMA expr .)
    COMMA           reduce using rule 30 (expr_list -> expr_list COMMA expr .)


state 91

    (26) if_stmt -> IF expr THEN stmt ELSE stmt .

    END             reduce using rule 26 (if_stmt -> IF expr THEN stmt ELSE stmt .)
    SEMICOLON       reduce using rule 26 (if_stmt -> IF expr THEN stmt ELSE stmt .)
    ELSE            reduce using rule 26 (if_stmt -> IF expr THEN stmt ELSE stmt .)

